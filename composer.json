{
    "name": "sahilphp/vue",
    "description": "Vue UI integration for SahilPHP applications.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/sahilphp/vue",
    "support": {
        "issues": "https://github.com/sahilphp/vue/issues",
        "source": "https://github.com/sahilphp/vue"
    },
    "require": {
        "php": ">=8.2",
        "sahilphp/framework": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php scripts/refuse-create-project.php"
        ],
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc -b --noEmit"
    },
    "config": {
        "sahil": {
            "app": {
                "name": "SahilPHP",
                "url": "http://localhost:8000",
                "environment": "development"
            },
            "database": {
                "default": "sqlite",
                "connections": {
                    "sqlite": {
                        "driver": "sqlite",
                        "database": "database/database.sqlite",
                        "prefix": ""
                    }
                }
            },
            "view": {
                "paths": [
                    "resources/views"
                ],
                "extension": ".sahil.php"
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.phpunit.cache",
            "/composer.lock",
            "/node_modules",
            "/package-lock.json",
            "/tests",
            "/vendor"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": []
}
