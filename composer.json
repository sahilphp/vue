{
    "name": "sahilphp/vue",
    "description": "SahilPHP starter-kit for Vue 3 and TypeScript projects",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "sahilphp/framework": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc -b --noEmit"
    },
    "config": {
        "sahil": {
            "app": {
                "name": "SahilPHP",
                "url": "http://localhost:8000",
                "environment": "development"
            },
            "database": {
                "default": "sqlite",
                "connections": {
                    "sqlite": {
                        "driver": "sqlite",
                        "database": "database/database.sqlite",
                        "prefix": ""
                    }
                }
            },
            "view": {
                "paths": ["resources/views"],
                "extension": ".sahil.php"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [],
    "config": {}
}
